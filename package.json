{
  "name": "subscrio",
  "version": "0.4.0",
  "description": "Open-source TypeScript entitlement engine for plan-based feature access, limits, subscriptions, and customer overrides",
  "author": "Subscrio Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subscrio/subscrio-typescript.git"
  },
  "homepage": "https://subscrio.com/typescript-entitlement-library/",
  "bugs": {
    "url": "https://github.com/subscrio/subscrio-typescript/issues"
  },
  "keywords": [
    "entitlement",
    "entitlements",
    "feature-entitlements",
    "feature-gating",
    "plan-based-access",
    "subscription",
    "typescript",
    "stripe",
    "postgresql",
    "drizzle"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "require": "./dist/config/index.cjs",
      "types": "./dist/config/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "vite build",
    "build": "vite build",
    "test": "vitest run",
    "test:core": "vitest run",
    "test:extensions": "npm run test --prefix ../../extensions/audit-log/typescript && npm run test --prefix ../../extensions/payments/typescript",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:debug": "cross-env KEEP_TEST_DB=true vitest run",
    "typecheck": "tsc --noEmit",
    "db:rebuild": "tsx scripts/rebuild-dev-db.ts",
    "migrate": "tsx src/cli/migrate.ts"
  },
  "bin": {
    "subscrio-migrate": "dist/subscrio-migrate.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "stripe": "^22.5.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "@typescript/typescript6": "^6.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  }
}
